<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CutiFlow" targetNamespace="http://arunakarya.example/cutiflow" exporter="ba-toolkit" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_CutiFlow">
    <bpmn:participant id="Participant_CutiFlow" name="CutiFlow — leave approval" processRef="Process_LeaveApproval" />
  </bpmn:collaboration>
  <bpmn:process id="Process_LeaveApproval" name="Leave approval" isExecutable="false">
    <bpmn:documentation>Worked example for PT Aruna Karya. Same decisions as diagrams/cutiflow-leave-approval.svg. This file is a documentation model (isExecutable is false), not a Camunda deployment. HR approval is required when working days are greater than 3, or the leave type is unpaid or special.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_CutiFlow">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Start_Leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Revise</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="CutiFlow">
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_HRNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectedSupervisor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR Admin">
        <bpmn:flowNodeRef>Task_HRReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_HRDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RejectedHR</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Leave" name="Leave needed">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Submit" name="Submit leave request">
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Revise" name="Revise request">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
      <bpmn:incoming>Flow_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_Revise_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Validate" name="Validate request">
      <bpmn:incoming>Flow_Submit_Validate</bpmn:incoming>
      <bpmn:incoming>Flow_Revise_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Gw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Valid" name="Valid?">
      <bpmn:incoming>Flow_Validate_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Review" name="Review request">
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Decision" name="Supervisor decision">
      <bpmn:incoming>Flow_Review_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_Supervisor</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approve_Supervisor</bpmn:outgoing>
      <bpmn:outgoing>Flow_Return</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RejectedSupervisor" name="Rejected">
      <bpmn:incoming>Flow_Reject_Supervisor</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_HRNeeded" name="HR needed?">
      <bpmn:incoming>Flow_Approve_Supervisor</bpmn:incoming>
      <bpmn:outgoing>Flow_HRNotRequired</bpmn:outgoing>
      <bpmn:outgoing>Flow_HRRequired</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Post" name="Update balance and calendar">
      <bpmn:incoming>Flow_HRNotRequired</bpmn:incoming>
      <bpmn:incoming>Flow_Approve_HR</bpmn:incoming>
      <bpmn:outgoing>Flow_Post_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Approved" name="Approved">
      <bpmn:incoming>Flow_Post_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_HRReview" name="HR review">
      <bpmn:incoming>Flow_HRRequired</bpmn:incoming>
      <bpmn:outgoing>Flow_HRReview_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_HRDecision" name="HR decision">
      <bpmn:incoming>Flow_HRReview_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_HR</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approve_HR</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_RejectedHR" name="Rejected">
      <bpmn:incoming>Flow_Reject_HR</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="Start_Leave" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_Submit_Validate" sourceRef="Task_Submit" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_Revise_Validate" sourceRef="Task_Revise" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_Validate_Gw" sourceRef="Task_Validate" targetRef="Gw_Valid" />
    <bpmn:sequenceFlow id="Flow_Invalid" name="No" sourceRef="Gw_Valid" targetRef="Task_Revise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">request fails validation</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Valid" name="Yes" sourceRef="Gw_Valid" targetRef="Task_Review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">request passes validation</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Review_Decision" sourceRef="Task_Review" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="Flow_Reject_Supervisor" name="Reject" sourceRef="Gw_Decision" targetRef="End_RejectedSupervisor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">supervisor rejects</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Approve_Supervisor" name="Approve" sourceRef="Gw_Decision" targetRef="Gw_HRNeeded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">supervisor approves</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Return" name="Return" sourceRef="Gw_Decision" targetRef="Task_Revise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">supervisor returns for changes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HRNotRequired" name="No" sourceRef="Gw_HRNeeded" targetRef="Task_Post">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">working days &lt;= 3 and type is annual or sick</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HRRequired" name="Yes" sourceRef="Gw_HRNeeded" targetRef="Task_HRReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">working days &gt; 3 or type is unpaid or special</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HRReview_Decision" sourceRef="Task_HRReview" targetRef="Gw_HRDecision" />
    <bpmn:sequenceFlow id="Flow_Reject_HR" name="Reject" sourceRef="Gw_HRDecision" targetRef="End_RejectedHR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">HR rejects</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Approve_HR" name="Approve" sourceRef="Gw_HRDecision" targetRef="Task_Post">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">HR approves</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Post_End" sourceRef="Task_Post" targetRef="End_Approved" />
    <bpmn:textAnnotation id="Note_HRRule">
      <bpmn:text>Second approval when working days are greater than 3, or the type is unpaid or special. Annual balance changes only for annual leave and cuti bersama.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_HRRule" sourceRef="Gw_HRNeeded" targetRef="Note_HRRule" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_CutiFlow">
    <bpmndi:BPMNPlane id="BPMNPlane_CutiFlow" bpmnElement="Collaboration_CutiFlow">
      <bpmndi:BPMNShape id="Participant_CutiFlow_di" bpmnElement="Participant_CutiFlow" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1620" height="800" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Employee_di" bpmnElement="Lane_Employee" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1590" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="190" y="280" width="1590" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Supervisor_di" bpmnElement="Lane_Supervisor" isHorizontal="true">
        <dc:Bounds x="190" y="500" width="1590" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_HR_di" bpmnElement="Lane_HR" isHorizontal="true">
        <dc:Bounds x="190" y="700" width="1590" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Leave_di" bpmnElement="Start_Leave">
        <dc:Bounds x="252" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="236" y="205" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Submit_di" bpmnElement="Task_Submit">
        <dc:Bounds x="330" y="140" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Revise_di" bpmnElement="Task_Revise">
        <dc:Bounds x="540" y="140" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="540" y="340" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Valid_di" bpmnElement="Gw_Valid" isMarkerVisible="true">
        <dc:Bounds x="740" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="748" y="331" width="34" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="860" y="560" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Decision_di" bpmnElement="Gw_Decision" isMarkerVisible="true">
        <dc:Bounds x="1070" y="575" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1062" y="548" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RejectedSupervisor_di" bpmnElement="End_RejectedSupervisor">
        <dc:Bounds x="1077" y="640" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1074" y="680" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_HRNeeded_di" bpmnElement="Gw_HRNeeded" isMarkerVisible="true">
        <dc:Bounds x="1180" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1176" y="331" width="62" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Post_di" bpmnElement="Task_Post">
        <dc:Bounds x="1320" y="340" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Approved_di" bpmnElement="End_Approved">
        <dc:Bounds x="1560" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1554" y="405" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HRReview_di" bpmnElement="Task_HRReview">
        <dc:Bounds x="1220" y="740" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_HRDecision_di" bpmnElement="Gw_HRDecision" isMarkerVisible="true">
        <dc:Bounds x="1430" y="755" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1424" y="812" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RejectedHR_di" bpmnElement="End_RejectedHR">
        <dc:Bounds x="1540" y="762" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1536" y="805" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_HRRule_di" bpmnElement="Note_HRRule">
        <dc:Bounds x="860" y="300" width="280" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Submit_di" bpmnElement="Flow_Start_Submit">
        <di:waypoint x="288" y="180" />
        <di:waypoint x="330" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Submit_Validate_di" bpmnElement="Flow_Submit_Validate">
        <di:waypoint x="490" y="180" />
        <di:waypoint x="510" y="180" />
        <di:waypoint x="510" y="380" />
        <di:waypoint x="540" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Revise_Validate_di" bpmnElement="Flow_Revise_Validate">
        <di:waypoint x="615" y="220" />
        <di:waypoint x="615" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Validate_Gw_di" bpmnElement="Flow_Validate_Gw">
        <di:waypoint x="690" y="380" />
        <di:waypoint x="740" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Invalid_di" bpmnElement="Flow_Invalid">
        <di:waypoint x="765" y="355" />
        <di:waypoint x="765" y="180" />
        <di:waypoint x="690" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="770" y="162" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Valid_di" bpmnElement="Flow_Valid">
        <di:waypoint x="765" y="405" />
        <di:waypoint x="765" y="600" />
        <di:waypoint x="860" y="600" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="772" y="498" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Review_Decision_di" bpmnElement="Flow_Review_Decision">
        <di:waypoint x="1020" y="600" />
        <di:waypoint x="1070" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reject_Supervisor_di" bpmnElement="Flow_Reject_Supervisor">
        <di:waypoint x="1095" y="625" />
        <di:waypoint x="1095" y="640" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1100" y="632" width="36" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approve_Supervisor_di" bpmnElement="Flow_Approve_Supervisor">
        <di:waypoint x="1120" y="600" />
        <di:waypoint x="1140" y="600" />
        <di:waypoint x="1140" y="380" />
        <di:waypoint x="1180" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1146" y="562" width="42" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Return_di" bpmnElement="Flow_Return">
        <di:waypoint x="1095" y="575" />
        <di:waypoint x="1095" y="112" />
        <di:waypoint x="615" y="112" />
        <di:waypoint x="615" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="830" y="94" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HRNotRequired_di" bpmnElement="Flow_HRNotRequired">
        <di:waypoint x="1230" y="380" />
        <di:waypoint x="1320" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1264" y="362" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HRRequired_di" bpmnElement="Flow_HRRequired">
        <di:waypoint x="1205" y="405" />
        <di:waypoint x="1205" y="780" />
        <di:waypoint x="1220" y="780" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1210" y="560" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HRReview_Decision_di" bpmnElement="Flow_HRReview_Decision">
        <di:waypoint x="1370" y="780" />
        <di:waypoint x="1430" y="780" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reject_HR_di" bpmnElement="Flow_Reject_HR">
        <di:waypoint x="1480" y="780" />
        <di:waypoint x="1540" y="780" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1488" y="762" width="36" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approve_HR_di" bpmnElement="Flow_Approve_HR">
        <di:waypoint x="1455" y="755" />
        <di:waypoint x="1455" y="450" />
        <di:waypoint x="1410" y="450" />
        <di:waypoint x="1410" y="420" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1462" y="560" width="42" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Post_End_di" bpmnElement="Flow_Post_End">
        <di:waypoint x="1500" y="380" />
        <di:waypoint x="1560" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_HRRule_di" bpmnElement="Assoc_HRRule">
        <di:waypoint x="1180" y="380" />
        <di:waypoint x="1140" y="328" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
